{
  "name": "game-companion-runtime",
  "private": true,
  "version": "0.1.0",
  "description": "Single-session state coordinator for the Game Companion: journals core state events and hosts one agent session.",
  "type": "module",
  "engines": {
    "node": ">=22.23"
  },
  "scripts": {
    "chat": "node src/cli.ts chat",
    "status": "node src/cli.ts status",
    "consumer": "node src/cli.ts consumer",
    "repair": "node src/cli.ts repair",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "probe:provider": "node test/live/probe-provider.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
